<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <author>GeneralMeasurements</author>
 <comment>General Measurement, after Labber's Measurement Editor: the instruments of
the Instrument Server (left), the step sequence and log channels (middle), the
selected step channel's step items (right), the run and its live plot (bottom).
The code is gui/measurement/window.py; see docs/general-measurement.md.</comment>
 <class>GeneralMeasurement</class>
 <widget class="QMainWindow" name="GeneralMeasurement">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1320</width><height>860</height></rect>
  </property>
  <property name="windowTitle"><string>General Measurement</string></property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="central_lay">
    <item>
     <widget class="QSplitter" name="split_v">
      <property name="orientation"><enum>Qt::Vertical</enum></property>
      <widget class="QSplitter" name="split_h">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <widget class="QGroupBox" name="instruments_box">
        <property name="title"><string>Instruments</string></property>
        <layout class="QVBoxLayout" name="instruments_lay">
         <item>
          <widget class="QTreeWidget" name="instruments">
           <property name="toolTip"><string>Channels of the Instrument Server's connected instruments. Double-click a Set channel to step it, a Read channel to log it.</string></property>
           <column><property name="text"><string>Instrument / channel</string></property></column>
           <column><property name="text"><string>Unit</string></property></column>
          </widget>
         </item>
         <item>
          <layout class="QHBoxLayout" name="instruments_buttons">
           <item><widget class="QPushButton" name="btn_add_step"><property name="text"><string>Step it</string></property><property name="toolTip"><string>Add the selected Set channel to the step sequence</string></property></widget></item>
           <item><widget class="QPushButton" name="btn_add_log"><property name="text"><string>Log it</string></property><property name="toolTip"><string>Add the selected Read channel to the log channels</string></property></widget></item>
          </layout>
         </item>
         <item>
          <widget class="QLabel" name="instruments_hint">
           <property name="text"><string>Connect instruments in the Instrument Server; they appear here.</string></property>
           <property name="wordWrap"><bool>true</bool></property>
           <property name="styleSheet"><string notr="true">color: palette(mid);</string></property>
          </widget>
         </item>
        </layout>
       </widget>
       <widget class="QWidget" name="lists">
        <layout class="QVBoxLayout" name="lists_lay">
         <property name="leftMargin"><number>0</number></property>
         <property name="rightMargin"><number>0</number></property>
         <item>
          <widget class="QGroupBox" name="step_box">
           <property name="title"><string>Step sequence (first = inner loop)</string></property>
           <layout class="QVBoxLayout" name="step_lay">
            <item>
             <widget class="QTreeWidget" name="step_list">
              <property name="rootIsDecorated"><bool>false</bool></property>
              <property name="toolTip"><string>The first channel is stepped fastest (the inner loop). A channel with one value is set once, before the first point.</string></property>
              <column><property name="text"><string>Channel</string></property></column>
              <column><property name="text"><string>Values</string></property></column>
              <column><property name="text"><string>Points</string></property></column>
             </widget>
            </item>
            <item>
             <layout class="QHBoxLayout" name="step_buttons">
              <item><widget class="QPushButton" name="btn_step_remove"><property name="text"><string>Remove</string></property></widget></item>
              <item><widget class="QPushButton" name="btn_step_up"><property name="text"><string>Up</string></property></widget></item>
              <item><widget class="QPushButton" name="btn_step_down"><property name="text"><string>Down</string></property></widget></item>
              <item><spacer name="step_buttons_stretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
             </layout>
            </item>
           </layout>
          </widget>
         </item>
         <item>
          <widget class="QGroupBox" name="log_box">
           <property name="title"><string>Log channels</string></property>
           <layout class="QVBoxLayout" name="log_lay">
            <item>
             <widget class="QListWidget" name="log_list">
              <property name="toolTip"><string>Recorded at every point</string></property>
             </widget>
            </item>
            <item>
             <layout class="QHBoxLayout" name="log_buttons">
              <item><widget class="QPushButton" name="btn_log_remove"><property name="text"><string>Remove</string></property></widget></item>
              <item><widget class="QPushButton" name="btn_log_up"><property name="text"><string>Up</string></property></widget></item>
              <item><widget class="QPushButton" name="btn_log_down"><property name="text"><string>Down</string></property></widget></item>
              <item><spacer name="log_buttons_stretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
             </layout>
            </item>
           </layout>
          </widget>
         </item>
        </layout>
       </widget>
       <widget class="QGroupBox" name="channel_box">
        <property name="title"><string>Step channel</string></property>
        <layout class="QVBoxLayout" name="channel_lay">
         <item>
          <widget class="QLabel" name="channel_info">
           <property name="text"><string>Select a channel in the step sequence.</string></property>
           <property name="wordWrap"><bool>true</bool></property>
          </widget>
         </item>
         <item>
          <widget class="QListWidget" name="item_list">
           <property name="maximumSize"><size><width>16777215</width><height>110</height></size></property>
           <property name="toolTip"><string>Step items: their values are joined in this order</string></property>
          </widget>
         </item>
         <item>
          <layout class="QHBoxLayout" name="item_buttons">
           <item><widget class="QPushButton" name="btn_item_add"><property name="text"><string>Add item</string></property></widget></item>
           <item><widget class="QPushButton" name="btn_item_remove"><property name="text"><string>Remove item</string></property></widget></item>
           <item><spacer name="item_buttons_stretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          </layout>
         </item>
         <item>
          <layout class="QFormLayout" name="item_form">
           <item row="0" column="0"><widget class="QLabel" name="range_type_label"><property name="text"><string>Range type</string></property></widget></item>
           <item row="0" column="1"><widget class="QComboBox" name="range_type"/></item>
           <item row="1" column="0"><widget class="QLabel" name="start_label"><property name="text"><string>Start</string></property></widget></item>
           <item row="1" column="1"><widget class="SIEdit" name="item_start"/></item>
           <item row="2" column="0"><widget class="QLabel" name="stop_label"><property name="text"><string>Stop</string></property></widget></item>
           <item row="2" column="1"><widget class="SIEdit" name="item_stop"/></item>
           <item row="3" column="0"><widget class="QLabel" name="center_label"><property name="text"><string>Center</string></property></widget></item>
           <item row="3" column="1"><widget class="SIEdit" name="item_center"/></item>
           <item row="4" column="0"><widget class="QLabel" name="span_label"><property name="text"><string>Span</string></property></widget></item>
           <item row="4" column="1"><widget class="SIEdit" name="item_span"/></item>
           <item row="5" column="0"><widget class="QLabel" name="step_type_label"><property name="text"><string>Step type</string></property></widget></item>
           <item row="5" column="1"><widget class="QComboBox" name="step_type"/></item>
           <item row="6" column="0"><widget class="QLabel" name="n_points_label"><property name="text"><string>Points</string></property></widget></item>
           <item row="6" column="1">
            <widget class="QSpinBox" name="n_points">
             <property name="minimum"><number>1</number></property>
             <property name="maximum"><number>1000000</number></property>
            </widget>
           </item>
           <item row="7" column="0"><widget class="QLabel" name="step_size_label"><property name="text"><string>Step size</string></property></widget></item>
           <item row="7" column="1"><widget class="SIEdit" name="item_step"/></item>
           <item row="8" column="0"><widget class="QLabel" name="interpolation_label"><property name="text"><string>Interpolation</string></property></widget></item>
           <item row="8" column="1"><widget class="QComboBox" name="interpolation"/></item>
          </layout>
         </item>
         <item>
          <widget class="QGroupBox" name="channel_opts">
           <property name="title"><string>Channel</string></property>
           <layout class="QFormLayout" name="channel_opts_form">
            <item row="0" column="0"><widget class="QLabel" name="settle_label"><property name="text"><string>Wait after set</string></property></widget></item>
            <item row="0" column="1">
             <widget class="QDoubleSpinBox" name="settle">
              <property name="decimals"><number>3</number></property>
              <property name="maximum"><double>3600</double></property>
              <property name="suffix"><string> s</string></property>
             </widget>
            </item>
            <item row="1" column="1"><widget class="QCheckBox" name="snake"><property name="text"><string>Alternate direction (snake)</string></property></widget></item>
           </layout>
          </widget>
         </item>
         <item><spacer name="channel_stretch"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer></item>
        </layout>
       </widget>
      </widget>
      <widget class="QWidget" name="bottom">
       <layout class="QVBoxLayout" name="bottom_lay" stretch="0,1">
        <property name="leftMargin"><number>0</number></property>
        <property name="rightMargin"><number>0</number></property>
        <item>
         <widget class="QGroupBox" name="run_box">
          <property name="title"><string>Measurement</string></property>
          <layout class="QGridLayout" name="run_grid" columnstretch="0,1,0,1,0">
           <item row="0" column="0"><widget class="QLabel" name="name_label"><property name="text"><string>Name</string></property></widget></item>
           <item row="0" column="1"><widget class="QLineEdit" name="meas_name"><property name="placeholderText"><string>the data file's name</string></property></widget></item>
           <item row="0" column="2"><widget class="QLabel" name="data_dir_label"><property name="text"><string>Data folder</string></property></widget></item>
           <item row="0" column="3">
            <layout class="QHBoxLayout" name="data_dir_row">
             <item><widget class="QLineEdit" name="data_dir"/></item>
             <item><widget class="QPushButton" name="btn_browse"><property name="text"><string>…</string></property><property name="maximumSize"><size><width>30</width><height>16777215</height></size></property></widget></item>
            </layout>
           </item>
           <item row="1" column="0"><widget class="QLabel" name="comment_label"><property name="text"><string>Comment</string></property></widget></item>
           <item row="1" column="1"><widget class="QLineEdit" name="comment"/></item>
           <item row="1" column="2"><widget class="QLabel" name="after_label"><property name="text"><string>After the run</string></property></widget></item>
           <item row="1" column="3"><widget class="QComboBox" name="after"/></item>
           <item row="2" column="0" colspan="5">
            <layout class="QHBoxLayout" name="run_row">
             <item><widget class="QLabel" name="estimate"><property name="text"><string>—</string></property></widget></item>
             <item><spacer name="run_row_stretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
             <item><widget class="QPushButton" name="btn_dry_run"><property name="text"><string>Check</string></property><property name="toolTip"><string>Check every point against the channels' limits and estimate the time; sets nothing</string></property></widget></item>
             <item><widget class="QPushButton" name="btn_run"><property name="text"><string>Start</string></property></widget></item>
             <item><widget class="QPushButton" name="btn_pause"><property name="text"><string>Pause</string></property><property name="checkable"><bool>true</bool></property></widget></item>
             <item><widget class="QPushButton" name="btn_abort"><property name="text"><string>Stop</string></property></widget></item>
             <item><widget class="QProgressBar" name="progress"><property name="value"><number>0</number></property></widget></item>
            </layout>
           </item>
          </layout>
         </widget>
        </item>
        <item>
         <widget class="QWidget" name="plot_area">
          <layout class="QVBoxLayout" name="plot_lay">
           <property name="leftMargin"><number>0</number></property>
           <property name="rightMargin"><number>0</number></property>
           <item>
            <layout class="QHBoxLayout" name="plot_head">
             <item><widget class="QLabel" name="plot_y_label"><property name="text"><string>Plot</string></property></widget></item>
             <item><widget class="QComboBox" name="plot_y"><property name="sizeAdjustPolicy"><enum>QComboBox::AdjustToContents</enum></property><property name="minimumSize"><size><width>220</width><height>0</height></size></property><property name="toolTip"><string>The log channel to plot against the inner loop's channel (the line being measured)</string></property></widget></item>
             <item><spacer name="plot_head_stretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
            </layout>
           </item>
           <item>
            <widget class="PlotWidget" name="live_plot">
             <property name="minimumSize"><size><width>0</width><height>160</height></size></property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QMenuBar" name="menubar">
   <property name="geometry"><rect><x>0</x><y>0</y><width>1320</width><height>22</height></rect></property>
   <widget class="QMenu" name="menuFile">
    <property name="title"><string>&amp;File</string></property>
    <addaction name="actionNew"/>
    <addaction name="actionOpenSequence"/>
    <addaction name="actionSaveSequence"/>
    <addaction name="actionSaveSequenceAs"/>
    <addaction name="separator"/>
    <addaction name="actionCloseWindow"/>
   </widget>
   <widget class="QMenu" name="menuRun">
    <property name="title"><string>&amp;Run</string></property>
    <addaction name="actionDryRun"/>
    <addaction name="actionRun"/>
    <addaction name="actionPause"/>
    <addaction name="actionAbort"/>
   </widget>
   <addaction name="menuFile"/>
   <addaction name="menuRun"/>
  </widget>
  <widget class="QStatusBar" name="statusbar"/>
  <action name="actionNew"><property name="text"><string>&amp;New measurement</string></property></action>
  <action name="actionOpenSequence"><property name="text"><string>&amp;Open measurement…</string></property></action>
  <action name="actionSaveSequence"><property name="text"><string>&amp;Save measurement</string></property></action>
  <action name="actionSaveSequenceAs"><property name="text"><string>Save measurement &amp;as…</string></property></action>
  <action name="actionCloseWindow"><property name="text"><string>&amp;Close</string></property></action>
  <action name="actionDryRun"><property name="text"><string>&amp;Check</string></property></action>
  <action name="actionRun"><property name="text"><string>&amp;Start</string></property></action>
  <action name="actionPause"><property name="text"><string>&amp;Pause / resume</string></property></action>
  <action name="actionAbort"><property name="text"><string>S&amp;top</string></property></action>
 </widget>
 <customwidgets>
  <customwidget><class>SIEdit</class><extends>QLineEdit</extends><header>gmcore.gui.common.panels</header></customwidget>
  <customwidget><class>PlotWidget</class><extends>QGraphicsView</extends><header>pyqtgraph</header></customwidget>
 </customwidgets>
 <resources/>
 <connections/>
</ui>
