<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <author>GeneralMeasurements</author>
 <comment>Lake Shore 625 magnet supply panel (LakeShore625Panel), after the legacy
MagnetControl.vi. Cards are QFrames with card=true and labels &lt;frame&gt;_caption / _value /
_sub. The persistent-switch heater is shown read only; nothing here writes it.
Accent colour #2e86c1 (also in the code's ACCENT).</comment>
 <class>LakeShore625Panel</class>
 <widget class="QWidget" name="LakeShore625Panel">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>760</width><height>860</height></rect>
  </property>
  <property name="styleSheet">
   <string notr="true">QLabel[panelTitle=&quot;true&quot;] { background: #2e86c1; color: white; padding: 6px 10px; border-radius: 4px; font-size: 12pt; }
QGroupBox { border: 1px solid #2e86c1; border-radius: 6px; margin-top: 1.1em; padding: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #2e86c1; font-weight: bold; }
QFrame[card=&quot;true&quot;] { border: 1px solid #2e86c1; border-left: 6px solid #2e86c1; border-radius: 6px; background: palette(base); }
QProgressBar::chunk { background: #2e86c1; }</string>
  </property>
  <layout class="QVBoxLayout" name="root" stretch="0,0,0,0,0,1,0,0,0">
   <item>
    <layout class="QHBoxLayout" name="head">
     <item>
      <widget class="QLabel" name="title">
       <property name="text"><string>&lt;b&gt;name&lt;/b&gt; &amp;nbsp; lakeshore_625 &amp;nbsp; address</string></property>
       <property name="panelTitle" stdset="0"><bool>true</bool></property>
      </widget>
     </item>
     <item><spacer name="head_stretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
     <item><widget class="QLabel" name="status"><property name="text"><string>disconnected</string></property></widget></item>
     <item><widget class="QPushButton" name="btn_connect"><property name="text"><string>Connect</string></property></widget></item>
     <item><widget class="QPushButton" name="btn_disconnect"><property name="text"><string>Disconnect</string></property></widget></item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="top" stretch="3,2,2">
     <item>
      <widget class="QFrame" name="cardMain">
       <property name="card" stdset="0"><bool>true</bool></property>
       <layout class="QVBoxLayout" name="cardMain_lay">
        <item><widget class="QLabel" name="cardMain_caption"><property name="text"><string>&lt;b&gt;Magnet&lt;/b&gt;</string></property></widget></item>
        <item><widget class="QLabel" name="cardMain_value"><property name="styleSheet"><string notr="true">font-size: 34pt; font-family: Consolas, monospace;</string></property><property name="text"><string>—</string></property></widget></item>
        <item><widget class="QLabel" name="cardMain_sub"><property name="styleSheet"><string notr="true">color: palette(mid);</string></property><property name="text"><string/></property></widget></item>
       </layout>
      </widget>
     </item>
     <item>
      <layout class="QVBoxLayout" name="side">
       <item>
        <widget class="QFrame" name="cardI">
         <property name="card" stdset="0"><bool>true</bool></property>
         <layout class="QVBoxLayout" name="cardI_lay">
          <item><widget class="QLabel" name="cardI_caption"><property name="text"><string>&lt;b&gt;Output current&lt;/b&gt;</string></property></widget></item>
          <item><widget class="QLabel" name="cardI_value"><property name="styleSheet"><string notr="true">font-size: 16pt; font-family: Consolas, monospace;</string></property><property name="text"><string>—</string></property></widget></item>
          <item><widget class="QLabel" name="cardI_sub"><property name="styleSheet"><string notr="true">color: palette(mid);</string></property><property name="text"><string/></property></widget></item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QFrame" name="cardV">
         <property name="card" stdset="0"><bool>true</bool></property>
         <layout class="QVBoxLayout" name="cardV_lay">
          <item><widget class="QLabel" name="cardV_caption"><property name="text"><string>&lt;b&gt;Output voltage&lt;/b&gt;</string></property></widget></item>
          <item><widget class="QLabel" name="cardV_value"><property name="styleSheet"><string notr="true">font-size: 16pt; font-family: Consolas, monospace;</string></property><property name="text"><string>—</string></property></widget></item>
          <item><widget class="QLabel" name="cardV_sub"><property name="styleSheet"><string notr="true">color: palette(mid);</string></property><property name="text"><string/></property></widget></item>
         </layout>
        </widget>
       </item>
      </layout>
     </item>
     <item>
      <widget class="QGroupBox" name="lights">
       <property name="title"><string>Status</string></property>
       <layout class="QVBoxLayout" name="lights_lay">
        <item><widget class="Led" name="led_ramp"><property name="label" stdset="0"><string>—</string></property></widget></item>
        <item><widget class="Led" name="led_stable"><property name="label" stdset="0"><string>current stable</string></property></widget></item>
        <item><widget class="Led" name="led_psh"><property name="label" stdset="0"><string>P.S. heater</string></property><property name="toolTip"><string>Persistent-switch heater (read only)</string></property></widget></item>
        <item><widget class="Led" name="led_err"><property name="label" stdset="0"><string>supply errors</string></property></widget></item>
        <item><spacer name="lights_stretch"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>10</width><height>20</height></size></property></spacer></item>
       </layout>
      </widget>
     </item>
    </layout>
   </item>
   <item><widget class="FieldBar" name="bar"/></item>
   <item>
    <layout class="QHBoxLayout" name="prog" stretch="0,1,0">
     <item><widget class="QLabel" name="progress_label"><property name="text"><string>Ramp progress</string></property></widget></item>
     <item>
      <widget class="QProgressBar" name="progress">
       <property name="maximum"><number>1000</number></property>
       <property name="value"><number>0</number></property>
       <property name="format"><string/></property>
      </widget>
     </item>
     <item><widget class="QLabel" name="eta"><property name="text"><string>—</string></property></widget></item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="info">
     <property name="text"><string/></property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>
   <item>
    <widget class="TimeChart" name="chart">
     <property name="yLabel" stdset="0"><string>magnet</string></property>
     <property name="curves_spec" stdset="0"><string>output=#5dade2; target=#e67e22</string></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="low" stretch="3,2">
     <item>
      <widget class="QGroupBox" name="ramp_box">
       <property name="title"><string>Ramp</string></property>
       <layout class="QFormLayout" name="ramp_form">
        <item row="0" column="0"><widget class="QLabel" name="target_label"><property name="text"><string>Target</string></property></widget></item>
        <item row="0" column="1">
         <layout class="QHBoxLayout" name="target_row">
          <item><widget class="SIEdit" name="target"/></item>
          <item><widget class="QLabel" name="unit_t"><property name="text"><string>A</string></property></widget></item>
          <item><widget class="QLabel" name="at_label"><property name="text"><string>at</string></property></widget></item>
          <item><widget class="SIEdit" name="rate"/></item>
          <item><widget class="QLabel" name="unit_r"><property name="text"><string>A/s</string></property></widget></item>
          <item><spacer name="target_stretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property></spacer></item>
         </layout>
        </item>
        <item row="1" column="1">
         <layout class="QHBoxLayout" name="ramp_buttons">
          <item><widget class="QPushButton" name="btn_ramp"><property name="text"><string>Ramp…</string></property></widget></item>
          <item><widget class="QPushButton" name="btn_zero"><property name="text"><string>Ramp to zero…</string></property></widget></item>
          <item><widget class="QPushButton" name="btn_hold"><property name="text"><string>Hold</string></property><property name="toolTip"><string>Hold the present current (stops a ramp)</string></property></widget></item>
          <item><widget class="QPushButton" name="btn_update"><property name="text"><string>Update settings</string></property><property name="toolTip"><string>Read the settings from the instrument again (queries only), e.g. after a change on its front panel</string></property></widget></item>
          <item><spacer name="ramp_buttons_stretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property></spacer></item>
         </layout>
        </item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="mon_box">
       <property name="title"><string>Monitor</string></property>
       <layout class="QFormLayout" name="mon_form">
        <item row="0" column="0"><widget class="QLabel" name="buffer_label"><property name="text"><string>Stable buffer</string></property></widget></item>
        <item row="0" column="1">
         <widget class="QSpinBox" name="buffer">
          <property name="minimum"><number>3</number></property>
          <property name="maximum"><number>600</number></property>
          <property name="value"><number>10</number></property>
          <property name="suffix"><string> samples</string></property>
         </widget>
        </item>
        <item row="1" column="0"><widget class="QLabel" name="tol_label"><property name="text"><string>within ±</string></property></widget></item>
        <item row="1" column="1">
         <widget class="QDoubleSpinBox" name="tol">
          <property name="decimals"><number>4</number></property>
          <property name="minimum"><double>0.0001</double></property>
          <property name="maximum"><double>1.0</double></property>
          <property name="singleStep"><double>0.001</double></property>
          <property name="suffix"><string> A</string></property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
    </layout>
   </item>
   <item><widget class="CsvLog" name="log"/></item>
   <item>
    <layout class="QHBoxLayout" name="foot">
     <item><widget class="QCheckBox" name="live"><property name="text"><string>Live</string></property><property name="checked"><bool>true</bool></property></widget></item>
     <item><widget class="QDoubleSpinBox" name="interval"><property name="suffix"><string> s</string></property></widget></item>
     <item><widget class="QPushButton" name="btn_read"><property name="text"><string>Read now</string></property></widget></item>
     <item><spacer name="foot_stretch"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
     <item><widget class="QPushButton" name="btn_safe"><property name="text"><string>Safe state</string></property></widget></item>
    </layout>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget><class>Led</class><extends>QLabel</extends><header>gmcore.gui.common.widgets</header></customwidget>
  <customwidget><class>FieldBar</class><extends>QWidget</extends><header>gmcore.gui.common.widgets</header></customwidget>
  <customwidget><class>TimeChart</class><extends>QWidget</extends><header>gmcore.gui.common.widgets</header></customwidget>
  <customwidget><class>CsvLog</class><extends>QWidget</extends><header>gmcore.gui.common.widgets</header></customwidget>
  <customwidget><class>SIEdit</class><extends>QLineEdit</extends><header>gmcore.gui.common.panels</header></customwidget>
 </customwidgets>
 <resources/>
 <connections/>
</ui>
