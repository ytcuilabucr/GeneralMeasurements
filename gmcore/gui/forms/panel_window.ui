<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <author>GeneralMeasurements</author>
 <comment>One instrument's panel window (PanelWindow), opened from the Instrument Server.
The code puts the panel in `scroll_area`, and the Essential / Expanded / All buttons in
`show_bar` (hidden for panels without folds).</comment>
 <class>PanelWindow</class>
 <widget class="QMainWindow" name="PanelWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>780</width><height>860</height></rect>
  </property>
  <property name="windowTitle"><string>Instrument panel</string></property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="central_lay">
    <property name="leftMargin"><number>0</number></property>
    <property name="topMargin"><number>0</number></property>
    <property name="rightMargin"><number>0</number></property>
    <property name="bottomMargin"><number>0</number></property>
    <item>
     <widget class="QScrollArea" name="scroll_area">
      <property name="widgetResizable"><bool>true</bool></property>
      <widget class="QWidget" name="scroll_contents">
       <property name="geometry"><rect><x>0</x><y>0</y><width>760</width><height>800</height></rect></property>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QToolBar" name="show_bar">
   <property name="windowTitle"><string>Show</string></property>
   <property name="movable"><bool>false</bool></property>
   <attribute name="toolBarArea"><enum>TopToolBarArea</enum></attribute>
   <attribute name="toolBarBreak"><bool>false</bool></attribute>
  </widget>
 </widget>
 <resources/>
 <connections/>
</ui>
