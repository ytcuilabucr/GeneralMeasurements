<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <author>GeneralMeasurements</author>
 <comment>Monitor or chart window (ViewWindow). The code replaces the central widget with a
dock area (QtAds) holding the view; the view's content (one card per field, or a chart)
is built from the chosen fields. Actions: actionFields, actionStation.</comment>
 <class>ViewWindow</class>
 <widget class="QMainWindow" name="ViewWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>860</width><height>520</height></rect>
  </property>
  <property name="windowTitle"><string>Monitor / chart</string></property>
  <widget class="QWidget" name="centralwidget"/>
  <widget class="QToolBar" name="tools">
   <property name="windowTitle"><string>View</string></property>
   <attribute name="toolBarArea"><enum>TopToolBarArea</enum></attribute>
   <attribute name="toolBarBreak"><bool>false</bool></attribute>
   <addaction name="actionFields"/>
   <addaction name="actionStation"/>
  </widget>
  <action name="actionFields">
   <property name="text"><string>Fields…</string></property>
   <property name="toolTip"><string>Choose what this window shows</string></property>
  </action>
  <action name="actionStation">
   <property name="text"><string>Station</string></property>
   <property name="toolTip"><string>Bring the station window to the front</string></property>
  </action>
 </widget>
 <resources/>
 <connections/>
</ui>
